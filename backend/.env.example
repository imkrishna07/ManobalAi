# Local MongoDB instance. Create the database if it does not exist yet.
MONGO_URL=mongodb://localhost:27017
DB_NAME=manobal_ai

# Generate a private random value for local use (at least 32 characters).
AUTH_SECRET_KEY=replace-with-a-long-random-secret-before-starting

# Set true only for a local/demo environment. This provisions the documented
# sample accounts on backend startup; leave false for any shared deployment.
ENABLE_DEMO_ACCOUNTS=true

# Frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000
